PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=git_inside
DB_USER=root
DB_PASS=
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
# set true only to let Sequelize create tables instead of running database/schema.sql
DB_SYNC=false

# AI Dorm Manager - any OpenAI-compatible provider (free options: NVIDIA NIM, OpenRouter, Ollama)
# NVIDIA NIM: create a free key at https://build.nvidia.com (never commit your real key)
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# optional: how long to wait for the AI in milliseconds (default 45000; use more for slow local models)
AI_TIMEOUT_MS=60000
# Ollama (local) example: AI_BASE_URL=http://localhost:11434/v1 , AI_API_KEY stays empty, AI_MODEL=<model you pulled>
