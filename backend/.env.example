PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=git_inside
DB_USER=root
DB_PASS=
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
# set true only to let Sequelize create tables instead of running database/schema.sql
DB_SYNC=false

# AI Dorm Manager (Claude API) - get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
